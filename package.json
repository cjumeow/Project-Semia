{
    "name": "project-semia",
    "private": true,
    "workspaces": [
        "apps/*",
        "packages/*"
    ],
    "scripts": {
        "dev:corpus": "npm run dev -w @semia/corpus",
        "prototype:dark-mode": "npm run dev -w @semia/corpus",
        "build:extension": "npm run build -w @semia/extension",
        "build:corpus": "npm run build -w @semia/corpus",
        "build": "npm run build:extension && npm run build:corpus && node scripts/assemble-extension.mjs",
      "test": "vitest run",
      "test:watch": "vitest",
      "typecheck": "npm run typecheck -w @semia/extension && npm run typecheck -w @semia/corpus",
      "verify": "npm run typecheck && npm run test && npm run build",
      "spike:caption-pairing": "node --experimental-transform-types scripts/caption-pairing-spike.ts",
      "spike:funlingo-parity": "node --experimental-transform-types scripts/funlingo-parity-spike.ts"
    },
    "devDependencies": {
        "vitest": "^4.1.10"
    }
}

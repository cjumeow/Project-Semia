{
  "manifest_version": 3,
  "name": "Project-Semia",
  "version": "0.4.3",
  "description": "Capture language snippets from YouTube transcripts and web pages into SEMIA.",
  "permissions": ["storage", "tabs"],
  "options_ui": {
    "page": "options.html",
    "open_in_tab": false
  },
  "action": {
    "default_title": "Open SEMIA"
  },
  "host_permissions": [
    "https://www.youtube.com/*",
    "http://*/*",
    "https://*/*",
    "https://translate.googleapis.com/*",
    "https://api.deepseek.com/*",
    "https://api.openai.com/*"
  ],
  "background": {
    "service_worker": "dist/background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://www.youtube.com/*"],
      "js": ["dist/contentScript.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://www.youtube.com/*"],
      "js": ["dist/pageWorld.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["http://*/*", "https://*/*"],
      "exclude_matches": [
        "https://www.youtube.com/*",
        "https://youtube.com/*",
        "https://m.youtube.com/*"
      ],
      "js": ["dist/webContentScript.js"],
      "run_at": "document_idle"
    }
  ],
  "version_name": "0.4.3"
}
